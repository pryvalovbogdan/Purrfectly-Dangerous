# Private settings for generating the Xcode project (Tools/xcodegen.sh). Copy to `.env`, which git ignores.
# The Apple Developer team that signs the app (Xcode → Settings → Accounts, or developer.apple.com → Membership).
DEVELOPMENT_TEAM=

# Uploading to App Store Connect (Tools/release.sh; docs/release.md). In CI these come from GitHub secrets
# instead (ASC_KEY_P8 holds the key's text there, written to a temporary file).
# App Store Connect → Users and Access → Integrations → App Store Connect API: the key's Key ID and the Issuer ID.
ASC_KEY_ID=
ASC_ISSUER_ID=
# The downloaded AuthKey_<id>.p8 file; keep it outside the repo.
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
